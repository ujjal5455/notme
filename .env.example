# Copy this file to .env.local and fill in real values (Phase 4).
# .env.local is ignored by Git. Never put a service-role key in any VITE_ variable:
# everything prefixed with VITE_ is bundled into browser code and is public.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
